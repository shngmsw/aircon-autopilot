# Nature Remo のアクセストークン（https://home.nature.global で発行）
NATURE_ACCESS_TOKEN=

# 自宅の座標（Open-Meteoで外気温を取得。既定は東京駅）
LATITUDE=35.6812
LONGITUDE=139.7671

# 複数エアコンがある場合、対象を固定したいときだけ指定
APPLIANCE_ID=

# 制御間隔（分）と、操作後の最小保持時間（分）
CONTROL_INTERVAL_MIN=10
MIN_HOLD_MIN=10

# 温度帯切替のヒステリシス（℃）
HYSTERESIS=0.7

# Remoセンサーの補正値（自己発熱で高く出る場合は -1.0 など）
ROOM_TEMP_OFFSET=0.0

# 外気冷却モード（外が涼しいときは冷房をやめて送風にする。送風非対応機なら電源オフ）
FREE_COOL_ENABLED=true
# 突入できる外気温の上限（℃）。抜けるには HYSTERESIS 分だけ超える必要がある
FREE_COOL_OUT_MAX=25.0
# 突入できる湿度の上限（%）。蒸し暑いときは冷房のまま
FREE_COOL_HUMID_MAX=70.0
# この室温以上、かつ送風開始時より FREE_COOL_RISE_MIN 以上上がったら冷房へ復帰（℃）
# 室温が高くても横ばいなら、外が涼しい限り送風のまま
FREE_COOL_ABORT_ROOM=30.5
FREE_COOL_RISE_MIN=0.5
# 冷房へ復帰したあと、この時間は外気冷却モードへ再突入しない（分）
FREE_COOL_LOCKOUT_MIN=45

# 外気が涼しい(<28℃)のに室温が暑い(≥27℃)ときの冷房目標温度（℃）
# 外が涼しければ軽く冷やすだけでよい。25℃だと全力運転でエアコン近くが寒くなる
COOL_OUT_HOT_TARGET=27.0

# --- 室温追従モード ---
# 設定温度ではなく室温そのものを目標帯に保つ。エアコンの設定温度と実際の
# 室温には部屋ごとにずれがあるため、室温を見て設定温度を上下させて追い込む。
# false にすると従来の (外気帯×室温帯) マトリクスで目標温度を決める。
ROOM_TARGET_ENABLED=true
# 保ちたい室温の下限・上限（℃）。この幅がヒステリシスを兼ねる
ROOM_TARGET_LOW=24.0
ROOM_TARGET_HIGH=25.0
# 目標をどれだけ超えているかに対して、設定温度を何倍下げるか。
# 1.5 なら「3℃オーバーで設定を5℃下げる」。大きいほど速いが行き過ぎやすい
ROOM_TARGET_GAIN=1.5
# 設定温度の下限・上限（℃）
ROOM_TARGET_SET_MIN=16.0
ROOM_TARGET_SET_MAX=30.0
# 目標帯の上端にこれだけ近ければ設定温度を動かさない（℃）
ROOM_TARGET_DEADBAND=0.3
# 目標をこれ以上超えていたら風量を最強にする（℃）。
# 弱い冷気で長く回すより、能力を出しきって早く目標へ入れる
ROOM_TARGET_MAX_VOL_OVER=1.0

# サーバー設定
HOST=0.0.0.0
PORT=8000
